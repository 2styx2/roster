#!/usr/bin/env python3
# Stand-in nmap for tests: nothing here touches a network. It answers `nmap -oX - ... TARGETS` with nmap's XML for
# the stand-in Hosts under FAKE_HOSTS (the same directories tests/fakes/ssh uses), and finds nothing without it:
#   DIR/NAME/address    the Host's address (10.0.0.5); a Host without one isn't on any network
#   DIR/NAME/ports      its open TCP ports, one a line: PORT SERVICE [PRODUCT...] (22 ssh OpenSSH 9.6)
#   DIR/NAME/hostname   its reverse-DNS name
#   DIR/NAME/title      the web page title nmap's http-title script would read
#   DIR/NAME/down       it doesn't answer
# Only ports in `-p LIST` are reported, as nmap does, and IPv6 targets only with -6 (then no IPv4 ones). A Host
# with none of them open is up with no ports, or (--open) left out.
# FAKE_NMAP_DELAY=SECS waits that long before answering (a scan to stop), FAKE_NMAP_FAIL=TEXT exits 1 with TEXT on
# stderr, and FAKE_LOG=FILE gets a line per run: "nmap ARGS".
import ipaddress, os, sys, time
from xml.sax.saxutils import quoteattr

args = sys.argv[1:]
os.environ.get("FAKE_LOG") and open(os.environ["FAKE_LOG"], "a").write("nmap " + " ".join(args) + "\n")
if os.environ.get("FAKE_NMAP_FAIL"):
    print(os.environ["FAKE_NMAP_FAIL"], file=sys.stderr)
    sys.exit(1)
time.sleep(float(os.environ.get("FAKE_NMAP_DELAY") or 0))

ports = None
if "-p" in args:
    ports = {int(p) for p in args[args.index("-p") + 1].split(",") if p.strip()}
# As nmap does: an IPv6 target only with -6, and then no IPv4 one ("Failed to resolve"; the rest are scanned)
family = 6 if "-6" in args else 4
targets = []
for a in args:
    try:
        t = ipaddress.ip_network(a, strict=False)
    except ValueError:
        continue
    if t.version == family:
        targets.append(t)
    else:
        print(f'Failed to resolve "{a}".', file=sys.stderr)


def read(d, name):
    p = os.path.join(d, name)
    return open(p).read().strip() if os.path.exists(p) else ""


out = ['<?xml version="1.0"?>', "<nmaprun>"]
root = os.environ.get("FAKE_HOSTS")
for name in sorted(os.listdir(root)) if root and os.path.isdir(root) else []:
    d = os.path.join(root, name)
    address = read(d, "address")
    if not address or os.path.exists(os.path.join(d, "down")):
        continue
    if not any(ipaddress.ip_address(address) in t for t in targets if t.version == ipaddress.ip_address(address).version):
        continue
    shown = [line for line in read(d, "ports").splitlines() if ports is None or int(line.split()[0]) in ports]
    if "--open" in args and not shown:
        continue                                # --open: a Host without an open port isn't in the output at all
    out.append('  <host><status state="up"/>')
    out.append(f'    <address addr={quoteattr(address)} addrtype="ipv{family}"/>')
    if read(d, "hostname"):
        out.append(f'    <hostnames><hostname name={quoteattr(read(d, "hostname"))} type="PTR"/></hostnames>')
    out.append("    <ports>")
    for line in read(d, "ports").splitlines():
        port, service, *product = line.split()
        if ports is not None and int(port) not in ports:
            continue
        script = f'<script id="http-title" output={quoteattr(read(d, "title"))}/>' if read(d, "title") and \
            service in ("http", "https") else ""
        out.append(f'      <port protocol="tcp" portid="{port}"><state state="open"/>'
                   f'<service name={quoteattr(service)} product={quoteattr(" ".join(product))}/>{script}</port>')
    out.append("    </ports>")
    out.append("  </host>")
out.append("</nmaprun>")
print("\n".join(out))
