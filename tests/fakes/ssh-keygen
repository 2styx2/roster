#!/bin/sh
# Fake ssh-keygen: appends its argv to $HOME/ssh-keygen.log and writes a
# made-up key pair to the -f FILE, tagged with the -C comment. On a fake Host
# (FAKE_SSH_HOST set by fake ssh) the key is that Host's own: AAAAmesh-NAME.
# A Box key of another type than ed25519 (-t) is AAAAfake-TYPE.
# With -y it prints FILE's public key (FILE.pub's line) and writes nothing.
echo "$*" >>"$HOME/ssh-keygen.log"
file= comment= public= type=ed25519
while [ $# -gt 0 ]; do
	case $1 in
	-f) file=$2; shift ;;
	-C) comment=$2; shift ;;
	-t) type=$2; shift ;;
	-P) shift ;;
	-y) public=1 ;;
	esac
	shift
done
[ -n "$file" ] || { echo "fake ssh-keygen: no -f" >&2; exit 1; }
if [ -n "$public" ]; then
	[ -f "$file" ] && [ -f "$file.pub" ] || { echo "fake ssh-keygen: $file: no key" >&2; exit 1; }
	exec cat "$file.pub"
fi
echo "FAKE PRIVATE KEY" >"$file"
chmod 600 "$file"
alg=ssh-ed25519 key=AAAAfake
case $type in
ecdsa) alg=ecdsa-sha2-nistp384 key=AAAAfake-ecdsa ;;
rsa) alg=ssh-rsa key=AAAAfake-rsa ;;
esac
[ -z "$FAKE_SSH_HOST" ] || alg=ssh-ed25519 key=AAAAmesh-$FAKE_SSH_HOST
echo "$alg $key $comment" >"$file.pub"
