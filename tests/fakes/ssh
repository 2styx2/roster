#!/usr/bin/env python3
# Stand-in ssh for tests: nothing here connects. By default it fails as an unreachable host would.
# FAKE_LOG=FILE                 append "ssh ARGS" per run (a test counts connection attempts with it)
# FAKE_SSH_STDERR / _EXIT       what to print on stderr and the exit code (a key login's outcome)
# FAKE_SSH_ACCEPT_NEW=FILE      before that outcome, append "IP ssh-ed25519 KEY" to FILE (roster's known_hosts), as real
#                               ssh does for a new Host under roster's StrictHostKeyChecking accept-new (T243); IP is
#                               FAKE_SSH_ACCEPT_NEW_IP (default 10.0.0.6)
# FAKE_SSH_PROMPT + _PASSWORD   act as a password login: run $SSH_ASKPASS PROMPT, as ssh does, and succeed
#                               only if it prints FAKE_SSH_PASSWORD (its stderr goes to ours, as with ssh); once
#                               logged in, it runs -o LocalCommand with sh -c (cmd.exe on Windows) when -o PermitLocalCommand=yes, as ssh does
# FAKE_SSH_HANG=FILE            write this process's pid to FILE, then hang for a minute before the login (a slow
#                               server's key exchange)
# FAKE_HOSTS=DIR                stand-in Hosts for the Mesh (tests/test_mesh.py): `ssh NAME CMD` runs CMD with sh in
#                               DIR/NAME as that Host (HOME=DIR/NAME/home), when that directory exists:
#                                 DIR/NAME/down     the Host is down: ssh times out (exit 255), nothing runs
#                                 DIR/NAME/esxi     it's ESXi: `uname -s` says VMkernel, and ESXi's own paths
#                                                   (/etc/ssh/keys-USER, /vmfs/volumes) are DIR/NAME/etc/..., DIR/NAME/vmfs/...
#                                 DIR/NAME/login    what `id -un` says there (fakes/host/id): the account logged in
#                                 DIR/NAME/blocked  ip:port lines this Host can't reach (its `nc -z` fails)
#                                 DIR/NAME/slow     seconds each connection to it takes before it runs anything
#                                 DIR/NAME/hc       its herdr-core: the stand-in hc run there (`ssh NAME hc ...`)
#                                                   takes this folder as its FAKE_HC_STATE (tests/fakes/hc)
#                                 DIR/NAME/hold    each connection to it waits while this file is there (the test
#                                                   deletes it to let them go: a signal, not a guess at how long)
#                               FAKE_HOST_PATH=DIR goes first on every stand-in Host's PATH (a test's own tools)
#                               Each run appends "start NAME" and "end NAME" to DIR/connections.
#                                 DIR/NAME/fips     a FIPS-mode Host (T239): its sshd offers only NIST kex and host
#                                                   keys (ssh -v says so) and takes a key login only with a key that
#                                                   isn't Ed25519 and is in its authorized_keys; the keys offered are
#                                                   the IdentityFiles roster's ssh config ($HOME/.ssh/config.d and
#                                                   roster-inventories), or -F FILE, gives NAME, each in turn (one whose private key file is
#                                                   gone isn't offered). Each key let in is appended to
#                                                   DIR/NAME/accepted. Else "Permission denied (publickey,password)",
#                                                   exit 255. DIR/NAME/refuse: globs of key file paths its sshd
#                                                   refuses whatever its authorized_keys says (one per line)
#                                                   FAKE_SSH_AS_PASSWORD=1: a password login (a test's stand-in for
#                                                   password_exec), which it takes
#                                 DIR/NAME/keys     as fips, but any key type (and no NIST lines): a Host whose sshd
#                                                   checks the offered key against its authorized_keys
#                                 DIR/NAME/windows  it's Windows (T195): `powershell ... -EncodedCommand B64` runs that
#                                                   PowerShell with pwsh (powershell.exe on Windows), stdin and all,
#                                                   with USERPROFILE=DIR/NAME/home, ProgramData=DIR/NAME/programdata,
#                                                   and stand-in whoami.exe, icacls.exe and Get-Acl (fakes/windows/acl.py;
#                                                   DIR/NAME/admin: the account is in Administrators). The file says
#                                                   which shell sshd hands the command line to (its DefaultShell):
#                                                   `cmd` (cmd.exe, Windows' default) or `powershell` (empty: that).
#                                                   A line that shell would read otherwise than as written (cmd: & | <
#                                                   > ^ % " or past 8191 characters; PowerShell: its own specials) is
#                                                   refused as that shell would garble it. `exit 0` is a key login
#                                                   test; any other command fails as that shell says it isn't one
#                                                   ("'sh' is not recognized ...", "The term 'sh' is not recognized")
#                                                   Under PowerShell, a command that failed exits 1, whatever its code
#                                                   was (as Win32-OpenSSH's `powershell -c` does)
#                                                   With DIR/NAME/keys too (#509 item 7), a key login (`exit 0`, or
#                                                   any command with BatchMode=yes) gets in only with a key the ssh
#                                                   config gives NAME (as fips's) whose line is in the file sshd reads
#                                                   for the account; else any roster-managed line lets it in. A
#                                                   password login (no BatchMode) is never checked
# FAKE_SH=PATH                  the sh a stand-in Host runs its side with (default /bin/sh; on native Windows, Git for
#                               Windows' sh.exe, with the Host's paths written C:/... as that sh reads them)
import base64, fnmatch, os, shutil, subprocess, sys, time
args = sys.argv[1:]
os.environ.get("FAKE_LOG") and open(os.environ["FAKE_LOG"], "a").write("ssh " + " ".join(args) + "\n")


def destination(argv):
    """(destination, the command words after it), as ssh reads its arguments."""
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            i += 1
            break
        if a.startswith("-") and len(a) > 1:
            if a[1] in "BbcDEeFIiJLlmOoPpQRSWw" and len(a) == 2:
                i += 2
            else:
                i += 1
            continue
        break
    return (argv[i], argv[i + 1:]) if i < len(argv) else (None, [])


WINDOWS_PRELUDE = r"""
function global:whoami.exe {
    if ($args -contains '/user') { '"example\admin","S-1-5-21-1000-1000-1000-1001"' }
    else {
        '"Everyone","Well-known group","S-1-1-0","Mandatory group, Enabled by default, Enabled group"'
        if (Test-Path -LiteralPath (Join-Path $env:FAKE_HOST_ROOT_NATIVE 'admin')) {
            '"BUILTIN\Administrators","Alias","S-1-5-32-544","Group used for deny only"'
        }
    }
    $global:LASTEXITCODE = 0
}
function global:icacls.exe { & $env:FAKE_PYTHON $env:FAKE_ACL icacls @args }
function global:Get-Acl {
    param([string]$LiteralPath)
    $j = (& $env:FAKE_PYTHON $env:FAKE_ACL get $LiteralPath) | ConvertFrom-Json
    $o = [pscustomobject]@{ AreAccessRulesProtected = [bool]$j.protected; OwnerSid = $j.owner; Allow = @($j.allow) }
    $o | Add-Member ScriptMethod GetAccessRules {
        param($explicit, $inherited, $type)
        foreach ($r in $this.Allow) {
            [pscustomobject]@{ IdentityReference = [pscustomobject]@{ Value = $r.sid }; FileSystemRights = $r.rights;
                               AccessControlType = $(if ($r.type) { $r.type } else { 'Allow' }) }
        }
    }
    $o | Add-Member ScriptMethod GetOwner { param($type) [pscustomobject]@{ Value = $this.OwnerSid } }
    $o
}
"""


def windows_key_login(root, dest):
    """Would the stand-in Windows Host's sshd let a roster key in? As the real one decides: an admin's keys are in
    the admin file (stock sshd_config), which it reads only with Microsoft's ACL; no BOM, no UTF-16. With ROOT/keys,
    only a key the ssh config offers for DEST whose line is in that file."""
    import json
    admin = os.path.exists(os.path.join(root, "admin"))
    f = os.path.join(root, "programdata", "ssh", "administrators_authorized_keys") if admin else \
        os.path.join(root, "home", ".ssh", "authorized_keys")
    data = open(f, "rb").read() if os.path.exists(f) else b""
    acls = os.path.join(root, "acls.json")
    st = os.stat(f) if os.path.exists(f) else None
    acl = (json.load(open(acls)) if os.path.exists(acls) else {}).get(f"{st.st_dev}:{st.st_ino}" if st else "")
    if admin and not (acl and acl["protected"] and acl["owner"] in ("S-1-5-18", "S-1-5-32-544")
                      and sorted(e["sid"] for e in acl["allow"] if e.get("type", "Allow") == "Allow")
                      == ["S-1-5-18", "S-1-5-32-544"]):
        data = b""                      # a wrong ACL: sshd ignores the file without a word
    if data.startswith((b"\xef\xbb\xbf", b"\xff\xfe")) or b" roster-managed:" not in data or (
            os.path.exists(os.path.join(root, "keys")) and not offered_in(dest, data)):
        print("admin@10.0.0.5: Permission denied (publickey,password,keyboard-interactive).", file=sys.stderr)
        return False
    return True


def offered_in(dest, data):
    """Is a key the ssh config offers DEST (each in turn, as ssh would) in authorized_keys text DATA?"""
    lines = [ln.split() for ln in data.decode(errors="replace").splitlines()]
    for f in identity_files(dest):
        pub = (open(f + ".pub").read().split() if os.path.exists(f) and os.path.exists(f + ".pub") else [])[:2]
        if len(pub) == 2 and any(ln[i:i + 2] == pub for ln in lines for i in range(len(ln))):
            return True
    return False


CMD_SPECIAL = set('&|<>^%"')                 # cmd.exe acts on these in a command line
PS_SPECIAL = set(";&$'\"(){}@#`|<>,")          # PowerShell's own syntax


def windows_host(root, command, dest=None):
    """Run COMMAND on the stand-in Windows Host at ROOT, as its DefaultShell (cmd.exe or PowerShell) reads the line:
    its exit code."""
    line = " ".join(command)
    if os.path.exists(os.path.join(root, "keys")) and "BatchMode=yes" in args and line.split() != ["exit", "0"] \
            and not windows_key_login(root, dest):
        return 255                      # a key login (over_key) with a key sshd doesn't take there
    shell = (open(os.path.join(root, "windows")).read().strip() or "powershell").lower()
    special = CMD_SPECIAL if shell == "cmd" else PS_SPECIAL
    words = line.split()
    if words[:1] == ["powershell"] and (any(c in special for c in line) or (shell == "cmd" and len(line) > 8191)):
        print(f"fake ssh: {shell} would not read this command line as written: {line[:80]}", file=sys.stderr)
        return 1
    if words[:1] == ["powershell"] and "-EncodedCommand" in words:
        boot = base64.b64decode(words[words.index("-EncodedCommand") + 1]).decode("utf-16-le")
        ps = shutil.which("pwsh") or (shutil.which("powershell.exe") if os.name == "nt" else None)
        if not ps:
            print("fake ssh: no PowerShell here to run a stand-in Windows Host with", file=sys.stderr)
            return 127
        home, programdata = os.path.join(root, "home"), os.path.join(root, "programdata")
        os.makedirs(home, exist_ok=True)
        env = {**os.environ, "OS": "Windows_NT", "USERPROFILE": home, "ProgramData": programdata,
               "FAKE_HOST_ROOT_NATIVE": root, "FAKE_PYTHON": sys.executable,
               "FAKE_ACL": os.path.join(os.path.dirname(os.path.abspath(__file__)), "windows", "acl.py")}
        code = base64.b64encode((WINDOWS_PRELUDE + "\n" + boot).encode("utf-16-le")).decode()
        # Win32-OpenSSH (8.1 and 9.5, measured on real Hosts) never delivers EOF on a child's stdin once more than 4096
        # bytes have passed: so here too, past 4096 bytes the child's stdin stays open until it exits by itself, and a
        # script that waits for EOF hangs (FAKE_EOF_WAIT seconds, then this fails as a stuck ssh would be killed)
        data = sys.stdin.buffer.read()
        p = subprocess.Popen([ps, "-NoProfile", "-NonInteractive", "-EncodedCommand", code], stdin=subprocess.PIPE,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env, cwd=home)
        import threading
        got = {}
        readers = [threading.Thread(target=lambda k=k, f=f: got.__setitem__(k, f.read()), daemon=True)
                   for k, f in (("out", p.stdout), ("err", p.stderr))]
        for t in readers:
            t.start()
        p.stdin.write(data)
        p.stdin.flush()
        if len(data) <= 4096:
            p.stdin.close()
        try:
            rc = p.wait(timeout=float(os.environ.get("FAKE_EOF_WAIT", "60")))
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()
            print("fake ssh: the Windows Host's command never ended (it waited for EOF on stdin past 4096 bytes)",
                  file=sys.stderr)
            return 255
        for t in readers:
            t.join()
        sys.stdout.buffer.write(got.get("out", b""))
        sys.stderr.buffer.write(got.get("err", b""))
        # sshd ran the line under `powershell -c` (DefaultShell PowerShell), which turns any failure into 1 (seen on a
        # real Host: `ssh HOST 'cmd /c exit 3'` exits 1); cmd.exe passes the code on
        return 1 if rc and shell == "powershell" else rc
    if words == ["exit", "0"]:        # a login test: this account's key file holds roster's key, and sshd would read it
        return 0 if windows_key_login(root, dest) else 255
    first = words[0] if words else ""
    if shell == "cmd":
        print(f"'{first}' is not recognized as an internal or external command,\noperable program or batch file.",
              file=sys.stderr)
    else:
        print(f"{first} : The term '{first}' is not recognized as the name of a cmdlet, function, script file, or "
              "operable program.", file=sys.stderr)
    return 1


def identity_files(dest):
    """The IdentityFiles the ssh config gives DEST, in order (what ssh would offer with IdentitiesOnly yes, each in
    turn): `-F FILE`'s when given (as ssh, then only that file), else roster's ($HOME/.ssh/config.d)."""
    if "-F" in args:
        files = [args[args.index("-F") + 1]]
    else:                                       # roster's, and its named Inventories' (ssh reaches them by Include)
        files = []
        for sub in ("config.d", "roster-inventories"):
            d = os.path.join(os.environ.get("HOME", ""), ".ssh", sub)
            files += [os.path.join(d, n) for n in sorted(os.listdir(d))] if os.path.isdir(d) else []
    found = []
    for f in files:
        block = None
        for line in open(f).read().splitlines():
            if line.startswith("Host "):
                block = line.split()[1]
            elif block == dest and line.strip().startswith("IdentityFile "):
                found.append(line.strip().split(" ", 1)[1].strip('"').replace("%%", "%"))
    return found


def key_taken(root, dest):
    """Would the stand-in Host's sshd at ROOT let this key login in? A FIPS-mode one (ROOT/fips) also refuses
    Ed25519, and ssh -v says it negotiated NIST algorithms."""
    fips = os.path.exists(os.path.join(root, "fips"))
    verbose = any(a.startswith("-v") for a in args)
    if verbose and fips:
        print("debug1: kex: algorithm: ecdh-sha2-nistp256\n"
              "debug1: kex: host key algorithm: ecdsa-sha2-nistp256", file=sys.stderr)
    if os.environ.get("FAKE_SSH_AS_PASSWORD") == "1":
        return True
    ak = os.path.join(root, "home", ".ssh", "authorized_keys")
    lines = [ln.split() for ln in open(ak).read().splitlines()] if os.path.exists(ak) else []
    refuse = os.path.join(root, "refuse")
    globs = open(refuse).read().split() if os.path.exists(refuse) else []
    for f in identity_files(dest):              # each in turn, as ssh offers them
        if any(fnmatch.fnmatch(f, g) for g in globs):
            continue
        pub = (open(f + ".pub").read().split() if os.path.exists(f) and os.path.exists(f + ".pub") else [])[:2]
        if verbose and pub:
            print(f"debug1: Offering public key: {f} {pub[0].upper().removeprefix('SSH-')}", file=sys.stderr)
        if len(pub) == 2 and not (fips and pub[0] == "ssh-ed25519") and any(ln[-3:-1] == pub or ln[:2] == pub
                                                                             for ln in lines):
            open(os.path.join(root, "accepted"), "a").write(" ".join(pub) + "\n")   # which key got in (a test reads it)
            return True
    print(f"{dest}: Permission denied (publickey,password).", file=sys.stderr)
    return False


hosts = os.environ.get("FAKE_HOSTS")
if hosts:
    dest, command = destination(args)
    root = os.path.join(hosts, dest or "-")
    if dest and os.path.isdir(root):
        # the Host's root as its sh names it: on Windows Git's sh names C:\x\y /c/x/y (and pwd -P says so)
        shroot = root
        if os.name == "nt":
            shroot = root.replace("\\", "/")
            if shroot[1:2] == ":":
                shroot = "/" + shroot[0].lower() + shroot[2:]
        log = os.path.join(hosts, "connections")
        if os.path.exists(os.path.join(root, "down")):
            open(log, "a").write(f"down {dest}\n")
            print(f"ssh: connect to host {dest} port 22: Connection timed out", file=sys.stderr)
            sys.exit(255)
        open(log, "a").write(f"start {dest}\n")
        windows = os.path.exists(os.path.join(root, "windows"))     # its own key login (windows_key_login)
        if not windows and any(os.path.exists(os.path.join(root, m)) for m in ("fips", "keys")) and not key_taken(root, dest):
            open(log, "a").write(f"end {dest}\n")
            sys.exit(255)
        hold, held_until = os.path.join(root, "hold"), time.monotonic() + 120    # pytest-timeout's, at most
        while os.path.exists(hold) and time.monotonic() < held_until:
            time.sleep(0.02)
        slow = os.path.join(root, "slow")
        if os.path.exists(slow):
            time.sleep(float(open(slow).read() or 1))
        if os.path.exists(os.path.join(root, "windows")):
            rc = windows_host(root, command, dest)
            sys.stdout.flush()
            open(log, "a").write(f"end {dest}\n")
            sys.exit(rc)
        line = " ".join(command) or "sh"
        stdin = sys.stdin.buffer.read().decode() if line == "sh -s" else None
        esxi = os.path.exists(os.path.join(root, "esxi"))

        def on_host(text):
            if esxi:
                text = text.replace("/etc/ssh/keys-", shroot + "/etc/ssh/keys-").replace("/vmfs/volumes", shroot + "/vmfs/volumes")
            return text

        os.makedirs(os.path.join(root, "home"), exist_ok=True)
        env = {**os.environ, "HOME": os.path.join(root, "home"), "FAKE_HOST_ROOT": shroot,
               # the Host's own herdr-core: the stand-in hc run there answers from DIR/NAME/hc (#556), not the Box's
               **({"FAKE_HC_STATE": os.path.join(root, "hc")} if os.path.isdir(os.path.join(root, "hc")) else {}),
               "PATH": os.pathsep.join([*filter(None, [os.environ.get("FAKE_HOST_PATH")]), os.path.join(os.path.dirname(os.path.abspath(__file__)), "host"),
                                        # Windows: the sh's own commands (sort, find) before Windows' namesakes
                                        *([os.path.dirname(os.environ.get("FAKE_SH", "/bin/sh"))] if os.name == "nt" else []),
                                        os.environ["PATH"]])}
        sh = os.environ.get("FAKE_SH", "/bin/sh")
        argv = [sh, "-s"] if stdin is not None else [sh, "-c", on_host(line)]
        # bytes both ways: no CRLF from Windows' text mode, as from a real Host
        r = subprocess.run(argv, input=on_host(stdin).encode() if stdin is not None else None, stdout=subprocess.PIPE,
                           env=env, cwd=env["HOME"])
        out = r.stdout.decode()
        # what the Host prints names its own paths, as a real ESXi's would
        sys.stdout.buffer.write(out.replace(shroot + "/etc/ssh/keys-", "/etc/ssh/keys-").replace(shroot + "/vmfs/volumes", "/vmfs/volumes").encode())
        sys.stdout.flush()
        time.sleep(0.01)
        open(log, "a").write(f"end {dest}\n")
        sys.exit(r.returncode)

if os.environ.get("FAKE_SSH_HANG"):
    open(os.environ["FAKE_SSH_HANG"], "w").write(str(os.getpid()))
    time.sleep(60)

prompt = os.environ.get("FAKE_SSH_PROMPT")
if prompt is not None and os.environ.get("SSH_ASKPASS"):
    r = subprocess.run([os.environ["SSH_ASKPASS"], prompt], stdout=subprocess.PIPE, text=True)
    if r.returncode == 0 and r.stdout == os.environ.get("FAKE_SSH_PASSWORD", "") + "\n":
        opts = dict(a.split("=", 1) for a, prev in zip(args, [None] + args) if prev == "-o" and "=" in a)
        if opts.get("PermitLocalCommand") == "yes" and opts.get("LocalCommand"):
            command = opts["LocalCommand"].replace("%%", "%")
            # the user's shell runs it: sh, or cmd.exe on Windows
            subprocess.run(command, shell=True) if os.name == "nt" else subprocess.run(["/bin/sh", "-c", command])
        sys.exit(0)
    print("root@127.0.0.1: Permission denied (publickey,password).", file=sys.stderr)
    sys.exit(255)
if os.environ.get("FAKE_SSH_ACCEPT_NEW"):
    with open(os.environ["FAKE_SSH_ACCEPT_NEW"], "a") as kh:
        kh.write(os.environ.get("FAKE_SSH_ACCEPT_NEW_IP", "10.0.0.6")
                 + " ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAcceptNewRecordedTheHostKeyHere\n")
print(os.environ.get("FAKE_SSH_STDERR", "fake ssh: not connecting to " + " ".join(args)), file=sys.stderr)
sys.exit(int(os.environ.get("FAKE_SSH_EXIT", "255")))
