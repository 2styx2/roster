#!/usr/bin/env python3
# Test stand-in for the 1Password CLI (op). Signed out until `op signin`. OLD_OP=1 mimics a version without --reveal.
# Stand-in for 1Password CLI v2: signed out until `op signin`; item "Network gear" in vault Infra.
# `op item list --categories Login --format json`: each item's overview as op 2 prints it (id, title, vault,
#   category, additional_information (a login's username), urls), never a field's value. FAKE_OP_ITEMS=JSON: those
#   items, [{"id", "title", "vault", "username", "urls": [...], "fields": {label: value}}] (default: the two below).
#   `op item get ID --fields label=X` reads one of their fields (it prints concealed ones only with --reveal).
#   FAKE_OP_CONCEALED=LABEL,...: those fields are CONCEALED (default: password), their value printed as a worst case.
# FAKE_OP_STORE=FILE: the items as FAKE_OP_ITEMS has them, kept in FILE, which `op item create` adds to and
#   `op item delete ID` takes from (each made item: {"id", "title", "vault", "fields": {label: value}, "urls": [href]}).
# FAKE_OP_VAULTS=JSON: `op vault list --format json`'s vaults, [{"id", "name"}] (default: Private and Infra).
# `op item create [ - ] [assignment...] [flags]` as op 2 takes it (developer.1password.com, item create): `-` reads
#   an item JSON template ({title, category, fields: [{id, type, purpose, label, value}], urls: [{href, primary}]})
#   on stdin, and can't go with --template; --vault (a name or id; default Private); --format json prints the item
#   made, field values and all, as op does: a new item's id is 26 lowercase letters and digits, as op's are, and its
#   overview carries created_at (now). --vault=VALUE as one word works too. FAKE_OP_WRITE_FAIL=TEXT: create fails with TEXT on stderr;
#   FAKE_OP_DELETE_FAIL=TEXT: delete does. FAKE_OP_CREATE_HANG=SECONDS: create saves the item, then answers that late;
#   FAKE_OP_CREATE_ANSWER=TEXT: it saves the item, then prints TEXT instead of the item (an answer that doesn't read).
# FAKE_OP_RAW=JSON: {"item get": TEXT, "item list": TEXT}: that command prints TEXT instead (malformed output).
# FAKE_ARGV_LOG=FILE: every call's full argv, one JSON list per line.
# FAKE_OP_ENV_LOG=FILE: every call's environment variable names (never their values), one JSON list per line.
import json, os, sys
a = sys.argv[1:]
os.environ.get("FAKE_ARGV_LOG") and open(os.environ["FAKE_ARGV_LOG"], "a").write(json.dumps(["op", *a]) + "\n")
os.environ.get("FAKE_OP_ENV_LOG") and open(os.environ["FAKE_OP_ENV_LOG"], "a").write(json.dumps(sorted(os.environ)) + "\n")
if a[:1] == ["--account"]: a = a[2:]
a = [w for x in a for w in (["--vault", x[8:]] if x.startswith("--vault=") else [x])]    # op takes either form
signed = os.environ.get("OP_SESSION_test") == "tok" or os.environ.get("OP_SERVICE_ACCOUNT_TOKEN")
os.environ.get("FAKE_LOG") and open(os.environ["FAKE_LOG"], "a").write("op " + " ".join(a[:2]) + "\n")
if a[0] == "whoami":
    sys.exit(0 if signed else 1)
if a[0] == "signin":
    print('export OP_SESSION_test="tok"\n# This command is meant to be used with your shell\'s eval function.'); sys.exit()
if not signed: print("[ERROR] 2026/10/07 account is not signed in", file=sys.stderr); sys.exit(1)
raw = json.loads(os.environ.get("FAKE_OP_RAW") or "{}")
if " ".join(a[:2]) in raw: print(raw[" ".join(a[:2])]); sys.exit()
items = {("Infra", "Network gear"): {"password": "pw-netops", "enable": "en-secret"},
         ("Infra", "Orion servers"): {"password": "pw-deploy"}}
if a[0] == "read":
    _, vault, item, field = a[1].split("/", 3)[0], *a[1][5:].split("/")
    v = items.get((vault, item), {}).get(field)
    if v is None: print(f'[ERROR] could not read secret {a[1]}', file=sys.stderr); sys.exit(1)
    print(v); sys.exit()
store = os.environ.get("FAKE_OP_STORE")
listed = json.loads(open(store).read() if store else os.environ.get("FAKE_OP_ITEMS") or "[]")
vaults = json.loads(os.environ.get("FAKE_OP_VAULTS") or '[{"id": "v-private", "name": "Private"}, {"id": "v-infra", "name": "Infra"}]')
def flag(name):
    return a[a.index(name) + 1] if name in a else None
if a[:2] == ["vault", "list"]:
    print(json.dumps([{"id": v["id"], "name": v["name"], "content_version": 1} for v in vaults])); sys.exit()
if a[:2] == ["item", "create"]:
    if "-" in a and "--template" in a: print("[ERROR] can't use both piped input and --template", file=sys.stderr); sys.exit(1)
    if os.environ.get("FAKE_OP_WRITE_FAIL"): print(os.environ["FAKE_OP_WRITE_FAIL"], file=sys.stderr); sys.exit(1)
    t = json.loads(sys.stdin.read()) if "-" in a else {}
    want = flag("--vault") or "Private"
    v = next((v for v in vaults if want in (v["id"], v["name"])), None)
    if v is None: print(f'[ERROR] "{want}" isn\'t a vault in this account. Specify the vault with its ID or name.', file=sys.stderr); sys.exit(1)
    fields = {f["label"]: f.get("value", "") for f in t.get("fields", []) if f.get("value")}
    for x in a[2:]:                                  # assignment statements: label=value (op's argv form)
        if "=" in x and not x.startswith("-"): k, _, val = x.partition("="); fields[k.split("[")[0]] = val
    import datetime
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    new = {"id": "itm%023d" % (len(listed) + 1), "created_at": now, "title": flag("--title") or t.get("title", ""), "vault": v["name"],
           "fields": fields, "urls": [u["href"] for u in t.get("urls", [])] + ([flag("--url")] if flag("--url") else [])}
    listed.append(new); open(store, "w").write(json.dumps(listed))
    if os.environ.get("FAKE_OP_CREATE_HANG"): import time; time.sleep(float(os.environ["FAKE_OP_CREATE_HANG"]))
    if "FAKE_OP_CREATE_ANSWER" in os.environ: print(os.environ["FAKE_OP_CREATE_ANSWER"]); sys.exit()
    print(json.dumps({"id": new["id"], "title": new["title"], "version": 1, "vault": {"id": v["id"], "name": v["name"]},
                      "category": "LOGIN", "fields": [{"id": k, "label": k, "value": val} for k, val in fields.items()],
                      "urls": [{"primary": True, "href": h} for h in new["urls"]]})); sys.exit()
if a[:2] == ["item", "delete"]:
    if os.environ.get("FAKE_OP_DELETE_FAIL"): print(os.environ["FAKE_OP_DELETE_FAIL"], file=sys.stderr); sys.exit(1)
    if not any(i["id"] == a[2] for i in listed): print(f'[ERROR] "{a[2]}" isn\'t an item.', file=sys.stderr); sys.exit(1)
    open(store, "w").write(json.dumps([i for i in listed if i["id"] != a[2]])); sys.exit()
if a[:2] == ["item", "list"]:
    cats = a[a.index("--categories") + 1].lower().split(",") if "--categories" in a else None
    vault = a[a.index("--vault") + 1] if "--vault" in a else None
    vault = next((v["name"] for v in vaults if vault == v["id"]), vault)        # by id or by name, as op
    print(json.dumps([{"id": i["id"], "title": i["title"], "version": 1, "vault": {"id": next((v["id"] for v in vaults if v["name"] == i["vault"]), "v-" + i["vault"]), "name": i["vault"]},
                       "category": i.get("category", "LOGIN"), "additional_information": i.get("username", ""),
                       "urls": [{"primary": n == 0, "href": u} for n, u in enumerate(i.get("urls") or [])],
                       "created_at": i.get("created_at", "2026-11-01T10:00:00Z"), "updated_at": i.get("created_at", "2026-11-01T10:00:00Z")}
                      for i in listed if (cats is None or i.get("category", "LOGIN").lower() in cats)
                      and vault in (None, i["vault"])])); sys.exit()
if a[:2] == ["item", "get"] and any(i["id"] == a[2] for i in listed):
    i = next(i for i in listed if i["id"] == a[2])
    label = a[a.index("--fields") + 1].split("=", 1)[1]
    if label not in i.get("fields", {}): print(f'[ERROR] could not find field {label}', file=sys.stderr); sys.exit(1)
    concealed = label == "password" and "--reveal" not in a
    value = "[use 'op item get {} --reveal' to reveal]".format(i["id"]) if concealed else i["fields"][label]
    kind = "CONCEALED" if label in os.environ.get("FAKE_OP_CONCEALED", "password").split(",") else "STRING"
    print(json.dumps({"id": label, "label": label, "type": kind, "value": value})); sys.exit()
if os.environ.get("OLD_OP") and "--reveal" in a: print("[ERROR] unknown flag: --reveal", file=sys.stderr); sys.exit(1)
if a[:2] == ["item", "get"]:
    item = a[2]; field = a[a.index("--fields") + 1].split("=", 1)[1]
    vault = a[a.index("--vault") + 1] if "--vault" in a else None
    hits = [v for (vv, n), v in items.items() if n == item and (vault is None or vv == vault)]
    if not hits: print(f'[ERROR] "{item}" isn\'t an item. Specify the item with its UUID, name, or domain.', file=sys.stderr); sys.exit(1)
    if field not in hits[0]: print(f'[ERROR] could not find field {field}', file=sys.stderr); sys.exit(1)
    print(json.dumps({"id": "x", "label": field, "value": hits[0][field]})); sys.exit()
sys.exit(2)
