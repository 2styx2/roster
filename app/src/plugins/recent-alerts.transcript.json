          "spec": {
            "run": "finder alerts",
            "text": "⚠ 1",
            "title": "1 recent alert"
          }
        },
        {
          "host": "esx-02",
          "op": "badge",
          "text": "1"
        },
        {
          "every": true,
          "id": "N",
          "ms": 30000,
          "op": "timer",
          "run": "fn"
        },
        {
          "level": "warn",
          "op": "notify",
          "text": "esx-02: ERROR: disk /dev/sda1 full"
        }
      ],
      "payload": {
        "host": "esx-02",
        "session": 1,
        "text": "booting\nERROR: disk /dev/sda1 full\nok\n"
      }
