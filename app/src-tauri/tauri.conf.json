{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roster",
  "mainBinaryName": "roster-app",
  "version": "0.6.0",
  "identifier": "dev.roster.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Roster",
        "width": 1180,
        "height": 740,
        "dragDropEnabled": false,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD-PARTY-NOTICES": "THIRD-PARTY-NOTICES"
    },
    "licenseFile": "../../LICENSE"
  }
}
