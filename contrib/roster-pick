#!/bin/sh
# roster-pick: choose a Host with fzf and ssh to it, as `roster pick [SSH ARGS]`.
#
# UNSUPPORTED: an example plugin, not part of roster and not tested.
# Install by copying it onto PATH and making it executable.
# See `roster help plugins` for the contract.
set -eu
host=$("$ROSTER_BIN" ls | fzf --prompt='host> ' | cut -d' ' -f1)
[ -n "$host" ] || exit 1
exec ssh "$host" "$@"
